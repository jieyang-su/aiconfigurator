+@contextmanager
+def _aic_nsys_range(name: str):
+    if os.getenv("SGLANG_AIC_NSYS_SEMANTIC_MARKERS", "").lower() not in (
+        "1",
+        "true",
+        "yes",
+    ):
+        yield
+        return
+    torch.cuda.nvtx.range_push(name)
+    try:
+        yield
+    finally:
+        torch.cuda.nvtx.range_pop()
